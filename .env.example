# Скопируйте этот файл в .env и заполните реальными значениями.
# .env в git не коммитится (см. .gitignore) — в нём боевые пароли.

# --- 1С API ---
API_BASE=http://77.51.227.6:80/buh30_upr/hs/api
API_USER=
API_PASS=

# --- Учётка для записи штрихкода в 1С (monitor_pl.py, pl_barcode) ---
PL_BARCODE_USER=
PL_BARCODE_PASS=

# --- OpenRouter (AI-детекция заполненных полей в waybill_app.py) ---
OPENROUTER_API_KEY=

# --- monitor_pl.py ---
DATE_RANGE_DAYS=14
POLL_INTERVAL_SEC=600
# DRY_RUN=1 — ничего не пишет в 1С, только логирует "[DRY-RUN] записал бы...".
# Поставить 0 только после проверки в сухом режиме на реальном сервере.
DRY_RUN=1
MAX_ORDERS_PER_RUN=50

# --- waybill_app.py: автокалибровка позиций полей по перетаскиваниям (необязательно) ---
CALIBRATE_MIN_SAMPLES=20
CALIBRATE_MIN_DRIFT=2.0
CALIBRATE_MAX_STEP=15.0
