# Скопируйте этот файл в .env и заполните реальными значениями.
# .env в git не коммитится (см. .gitignore) — в нём боевые пароли.

# --- 1С API ---
API_BASE=http://77.51.227.6:80/buh30_upr/hs/api
API_USER=
API_PASS=

# --- Учётка для записи штрихкода в 1С (monitor_pl.py, pl_barcode) ---
PL_BARCODE_USER=
PL_BARCODE_PASS=

# --- AI-детекция заполненных полей (vision-модель) ---
# Выбор провайдера: openrouter или aitunnel
AI_PROVIDER=openrouter

# OpenRouter (старый провайдер)
OPENROUTER_API_KEY=sk-or-v1-...ваш-ключ-здесь
OPENROUTER_URL=https://openrouter.ai/api/v1/chat/completions

# Aitunnel (новый провайдер, дешевле)
AITUNNEL_API_KEY=sk-aitunnel-...ваш-ключ-здесь
AITUNNEL_URL=https://api.aitunnel.ru/v1/chat/completions

# Модель (claude-sonnet-4.6 для OpenRouter как "anthropic/claude-sonnet-4.6",
# для Aitunnel просто "claude-sonnet-4.6")
AI_MODEL=claude-sonnet-4.6
# Модель — gpt-4o-mini, а не Claude Sonnet: задача (бинарная детекция
# "поле заполнено/пусто") простая, дорогая reasoning-модель не нужна,
# а gpt-4o-mini на proxyapi.ru ~в 20 раз дешевле Claude Sonnet.
AI_MODEL=gpt-4o-mini
#
# Если понадобится откатиться на OpenRouter (например proxyapi перестанет
# устраивать) — раскомментировать эти две строки вместо строк выше:
# AI_BASE_URL=https://openrouter.ai/api/v1/chat/completions
# AI_MODEL=anthropic/claude-sonnet-4.6

# --- monitor_pl.py ---
DATE_RANGE_DAYS=14
POLL_INTERVAL_SEC=600
# DRY_RUN=1 — ничего не пишет в 1С, только логирует "[DRY-RUN] записал бы...".
# Поставить 0 только после проверки в сухом режиме на реальном сервере.
DRY_RUN=1
MAX_ORDERS_PER_RUN=50

# --- waybill_app.py: автокалибровка позиций полей по перетаскиваниям (необязательно) ---
CALIBRATE_MIN_SAMPLES=20
CALIBRATE_MIN_DRIFT=2.0
CALIBRATE_MAX_STEP=15.0
